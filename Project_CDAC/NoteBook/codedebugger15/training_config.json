{
  "project_name": "CDAC_AI_Code_Reviewer_V15",
  "base_model": "Qwen/Qwen2.5-Coder-7B-Instruct",
  "target_languages": ["cpp", "java", "python"],
  "quantization": {
    "load_in_4bit": true,
    "quant_type": "nf4",
    "use_double_quant": true,
    "compute_dtype": "float16"
  },
  "lora": {
    "r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "bias": "none",
    "task_type": "CAUSAL_LM",
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ]
  },
  "training": {
    "learning_rate": 0.0002,
    "lr_scheduler_type": "cosine",
    "warmup_steps": 10,
    "weight_decay": 0.01,
    "num_train_epochs": 2,
    "per_device_train_batch_size": 2,
    "per_device_eval_batch_size": 2,
    "gradient_accumulation_steps": 8,
    "max_seq_length": 2048,
    "fp16": false,
    "bf16": false,
    "optim": "paged_adamw_8bit",
    "max_grad_norm": 0.3,
    "logging_steps": 10,
    "eval_steps": 25,
    "save_steps": 25,
    "save_total_limit": 2,
    "seed": 42
  },
  "dataset": {
    "train_samples_per_lang": 800,
    "val_samples_per_lang": 100,
    "test_samples_per_lang": 20,
    "total_train": 2400,
    "total_val": 300,
    "total_test": 60,
    "min_token_len": 50,
    "max_token_len": 2048,
    "anti_false_positive_ratio": 0.25
  },
  "hardware": {
    "target_gpu": "NVIDIA Tesla T4 (15GB)",
    "isolation_device": "0",
    "tokenizers_parallelism": false
  }
}
